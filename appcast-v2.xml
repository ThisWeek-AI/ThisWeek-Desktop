            <sparkle:version>0.1.10</sparkle:version>
            <sparkle:shortVersionString>0.1.10</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>10.13</sparkle:minimumSystemVersion>
            <description><![CDATA[<h2>ThisWeek Desktop 0.1.10</h2>
<p>See offline sync progress while notes download to this Mac.</p>
<ul>
  <li>Live “Syncing 42/180” indicator in the header while prefetch runs.</li>
  <li>Settings → General shows a progress bar for notes, summaries, and audio.</li>
  <li>Sync now button to refresh the offline pack on demand.</li>
</ul>
]]></description>
